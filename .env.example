# ============================================================
# Copy this file to .env and fill in ONE api key. That's enough to run.
#   cp .env.example .env
# ============================================================

# Which chat model to use: google | mistral | ollama | huggingface
LLM_PROVIDER=google

# Which embedding model to use: local | google
# "local" downloads all-MiniLM-L6-v2 once (~80MB) and needs no key.
EMBEDDING_PROVIDER=local

# ---- keys (only the one matching LLM_PROVIDER is required) ----
# https://aistudio.google.com/app/apikey  -> free tier
GOOGLE_API_KEY=your_google_key_here

# https://console.mistral.ai  -> free tier
MISTRAL_API_KEY=your_mistral_key_here

# https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=your_hf_token_here

# ---- model names ----
MISTRAL_MODEL=mistral-large-latest
GOOGLE_MODEL=gemini-2.0-flash
OLLAMA_MODEL=llama3.1
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GOOGLE_EMBEDDING_MODEL=models/text-embedding-004

# ---- behaviour ----
TEMPERATURE=0.4
MAX_QUESTIONS=8

# ---- voice ----
# whisper | google   (whisper = faster-whisper, offline, better with accents)
STT_PROVIDER=whisper
WHISPER_MODEL=base
# gtts | pyttsx3     (gtts = natural, needs internet; pyttsx3 = offline fallback)
TTS_PROVIDER=gtts

# ---- frontend ----
API_URL=http://127.0.0.1:8000
